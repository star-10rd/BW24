---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMessages } from '../i18n';

const locale = 'en' as const;
const en = getMessages('en');
const et = getMessages('et');
---

<BaseLayout locale={locale} current={null} indexable={false} path="" title={en.notFound.title}>
  <div class="content-shell content-shell--reading">
    <header class="page-heading">
      <p class="kicker">404</p>
      <h1>{en.notFound.title}</h1>
      <p class="lede">{en.notFound.description}</p>
      <p class="not-found-secondary" lang="et"><strong>{et.notFound.title}.</strong> {et.notFound.description}</p>
      <a class="text-action" href="/">{en.notFound.action}</a>
    </header>
  </div>
</BaseLayout>

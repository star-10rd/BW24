---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMessages } from '../../i18n';
import SectionView from '../../views/SectionView.astro';

const locale = 'en' as const;
const messages = getMessages(locale);
const section = messages.sections.training;
---

<BaseLayout locale={locale} current="training" path="training" title={section.title}>
  <SectionView {...section} />
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getMessages } from '../../../i18n';
import SearchView from '../../../views/SearchView.astro';
const locale = 'et' as const;
const messages = getMessages(locale);
---
<BaseLayout locale={locale} current={null} path="search" title={messages.sections.search.title}><SearchView locale={locale}/></BaseLayout>

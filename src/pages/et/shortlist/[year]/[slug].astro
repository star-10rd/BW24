---
import BaseLayout from '../../../../layouts/BaseLayout.astro'; import ProblemPage from '../../../../components/problem/ProblemPage.astro'; import { getProductCatalog } from '../../../../lib/product/catalog'; import { buildPublicProblemPage } from '../../../../lib/product/page-model'; import {getMessages} from '../../../../i18n';
export async function getStaticPaths(){const c=await getProductCatalog();return c.shortlist.map(p=>({params:{year:String(p.year),slug:p.slug},props:{problemKey:p.key}}));}
const locale='et' as const;const m=getMessages(locale);const {problemKey}=Astro.props;const c=await getProductCatalog();const problem=c.shortlist.find(x=>x.key===problemKey);if(!problem)throw new Error(`Unknown shortlist ${problemKey}`);const page=await buildPublicProblemPage(problem);const title=`Baltic Way ${page.year} · ${m.problem.shortlistProblem}`;const path=`shortlist/${page.year}/${page.slug}`;
---
<BaseLayout locale={locale} current="problems" path={path} title={title} description={title}><ProblemPage page={page} locale={locale}/></BaseLayout>

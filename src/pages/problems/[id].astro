---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProblemPage from '../../components/problem/ProblemPage.astro';
import { publicProblemFixtures } from '../../fixtures/problemFixtures';
import { formatAppearance, getPrimaryAppearance } from '../../lib/problems/model';
import type { ProblemDocument } from '../../lib/problems/types';

export function getStaticPaths() {
  return publicProblemFixtures.map((problem) => ({
    params: { id: problem.id },
    props: { problem },
  }));
}

interface Props {
  problem: ProblemDocument;
}

const { problem } = Astro.props;
const locale = 'en' as const;
const title = formatAppearance(getPrimaryAppearance(problem));
const path = `problems/${problem.id}`;
---

<BaseLayout locale={locale} current="problems" path={path} title={title}>
  <ProblemPage problem={problem} locale={locale} fixture={problem.id === 'demo'} />
</BaseLayout>

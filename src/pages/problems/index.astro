---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMessages } from '../../i18n';
import ProblemsView from '../../views/ProblemsView.astro';

const locale = 'en' as const;
const messages = getMessages(locale);
const section = messages.sections.problems;
---

<BaseLayout locale={locale} current="practice" path="problems" title={section.title}>
  <ProblemsView locale={locale} />
</BaseLayout>

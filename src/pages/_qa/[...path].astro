---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductCatalog } from '../../lib/product/catalog';
import { getPracticeCatalog } from '../../lib/product/practice-catalog';
import { getProblemResults } from '../../lib/product/results';
import { buildPublicProblemPage, type PublicProblemPageModel } from '../../lib/product/page-model';
import '../../styles/qa.css';
export async function getStaticPaths(){ if(import.meta.env.BW26_QA!=='1') return []; return [{params:{path:undefined}}]; }
const locale='en' as const;
const [catalog,practice]=await Promise.all([getProductCatalog(),getPracticeCatalog()]);
const pages=await Promise.all(catalog.allExercises.map(x=>buildPublicProblemPage(x))); const publicFinals=pages.filter(x=>x.kind==='final');
const noSolution=publicFinals.find(x=>x.solutions.length===0); const multi=publicFinals.slice().sort((a,b)=>b.solutions.length-a.solutions.length)[0]; const statementFigure=publicFinals.find(x=>x.statement.assets.length>0); const solutionFigure=publicFinals.find(x=>x.solutions.some(s=>s.assets.length>0)); const shortlist=pages.find(x=>x.kind==='shortlist'); const dailyExample=publicFinals.find(x=>x.dailyDates.length>0); let resultBacked=0; for(const x of publicFinals)if(await getProblemResults(x.year,Number(x.number)))resultBacked++;
const caseCandidates: Array<[string, PublicProblemPageModel | undefined]> = [['No verified solution',noSolution],['Most selected solution items',multi],['Statement figure',statementFigure],['Solution figure',solutionFigure],['Shortlist',shortlist]];
const cases: Array<[string, PublicProblemPageModel]> = caseCandidates.filter((entry): entry is [string, PublicProblemPageModel] => entry[1] !== undefined);
const modeExample=publicFinals.find(x=>x!==dailyExample)??publicFinals[0];
---
<BaseLayout locale={locale} current={null} path="_qa" title="P3E QA">
<div class="content-shell qa-shell"><header class="page-heading"><p class="kicker">Local only</p><h1>P3E QA</h1><p class="lede">Real production models and routes. This page is generated only when <code>BW26_QA=1</code>.</p></header>
<section class="qa-counts"><dl><div><dt>Website finals</dt><dd>{publicFinals.length}</dd></div><div><dt>Shortlist exercises</dt><dd>{catalog.shortlist.length}</dd></div><div><dt>Practice exercises</dt><dd>{practice.exercises.length}</dd></div><div><dt>Inactive finals</dt><dd>{catalog.inactiveFinalIds.length}</dd></div><div><dt>Daily pool</dt><dd>{catalog.finals.filter(x=>x.dailyEligible).length}</dd></div><div><dt>Verified-solution practice</dt><dd>{practice.exercises.filter(x=>x.solutionAvailable).length}</dd></div><div><dt>Result-backed public finals</dt><dd>{resultBacked}</dd></div></dl></section>
<section class="qa-cases"><h2>Rendering archetypes</h2><ul>{cases.map(([label,page])=><li><span>{label}</span><a href={page.route}>{page.kind==='final'?`${page.year}/${Number(page.number)}`:`${page.year}/${page.slug}`} →</a></li>)}</ul></section>
{dailyExample&&<section class="qa-cases"><h2>Daily experience states</h2><p>Same canonical page, product-state simulation.</p><ul><li><span>Archive</span><a href={`${dailyExample.route}?qa=archive`}>Open →</a></li><li><span>Current Daily lock</span><a href={`${dailyExample.route}?qa=daily-current`}>Open →</a></li><li><span>Past Daily · Solve</span><a href={`${dailyExample.route}?qa=daily-past-solve`}>Open →</a></li><li><span>Past Daily · Review</span><a href={`${dailyExample.route}?qa=daily-past-review`}>Open →</a></li></ul></section>}
{modeExample&&<section class="qa-cases"><h2>Practice experience states</h2><ul><li><span>Random · Solve</span><a href={`${modeExample.route}?qa=random-solve`}>Open →</a></li><li><span>Random · Review</span><a href={`${modeExample.route}?qa=random-review`}>Open →</a></li><li><span>Practice set · Solve</span><a href={`${modeExample.route}?qa=training-solve`}>Open →</a></li><li><span>Practice set · Review</span><a href={`${modeExample.route}?qa=training-review`}>Open →</a></li>{noSolution&&<li><span>Random · unavailable solution</span><a href={`${noSolution.route}?qa=random-review`}>Open →</a></li>}{multi&&<li><span>Practice set · multiple solutions</span><a href={`${multi.route}?qa=training-review`}>Open →</a></li>}{shortlist&&<li><span>Random · shortlist</span><a href={`${shortlist.route}?qa=random-solve`}>Open →</a></li>}</ul></section>}
{dailyExample&&<section class="qa-cases"><h2>Current-Daily precedence</h2><ul><li><span>Current Daily collision · Random</span><a href={`${dailyExample.route}?qa=random-current`}>Open →</a></li><li><span>Current Daily collision · Practice set</span><a href={`${dailyExample.route}?qa=training-current`}>Open →</a></li></ul></section>}
<section class="qa-table"><h2>Public exercise catalogue</h2><div class="qa-table-wrap"><table><thead><tr><th>ID</th><th>Domain</th><th>Solutions</th><th>Statement assets</th><th>Solution assets</th><th>Daily dates</th></tr></thead><tbody>{pages.map(page=><tr><td><a href={page.route}>{page.kind==='final'?`${page.year}/${Number(page.number)}`:`${page.year}/${page.slug}`}</a></td><td>{page.domain}</td><td>{page.solutions.length}</td><td>{page.statement.assets.length}</td><td>{page.solutions.reduce((n,s)=>n+s.assets.length,0)}</td><td>{page.dailyDates.length}</td></tr>)}</tbody></table></div></section></div>
</BaseLayout>

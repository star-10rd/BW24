---
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/400-italic.css';
import '@fontsource/stix-two-text/600.css';
import 'katex/dist/katex.min.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getMessages, type Locale } from '../../i18n';
import { renderProblemMarkdownCached } from '../../lib/problems/renderMarkdown';
import type { PublicProblemPageModel } from '../../lib/product/page-model';
import '../../styles/math.css';
import '../../styles/problem.css';

interface Props { page: PublicProblemPageModel; locale: Locale; }
const { page, locale } = Astro.props;
const messages=getMessages(locale); const domainName=messages.problem.domains[page.domain];
const subtopicLabel=(id:string,fallback:string)=>messages.taxonomy.subtopics[id]??fallback;
const title=page.kind==='final'?`${locale === 'et' ? 'Balti Tee' : 'Baltic Way'} ${page.year} · ${messages.archive.problem} ${Number(page.number)}`:`${locale === 'et' ? 'Balti Tee' : 'Baltic Way'} ${page.year} · ${messages.problem.shortlistProblem}`;
const statement=await renderProblemMarkdownCached(`${page.versionId}|statement`,page.statement.markdown,page.statement.assets,`${page.key}: statement`);
const renderedSolutions=await Promise.all(page.solutions.map(async(solution,index)=>{
 const displayMarkdown=solution.markdown.replace(/^\s*#{1,3}\s+Solution(?:\s+\d+)?\s*\n+/i,'');
 return { ...solution,label:page.solutions.length===1?messages.problem.solution:`${messages.problem.solution} ${index+1}`, rendered:await renderProblemMarkdownCached(`${page.versionId}|solution|${solution.id}`,displayMarkdown,solution.assets,`${page.key}: ${solution.id}`) };
}));
const numberFormat=new Intl.NumberFormat(locale==='et'?'et-EE':'en-US',{minimumFractionDigits:1,maximumFractionDigits:1});
const routeWithLocale=(route:string)=>locale==='en'?route:`/et${route}`;
const runtimeJson=JSON.stringify({
  locale,
  problem:{ id:page.key,route:page.route,collection:page.kind==='final'?'contest':'shortlist',year:page.year,numberOrSlug:page.kind==='final'?String(Number(page.number)):page.slug,domain:page.domain },
  labels:{ randomUnavailableDaily:messages.practice.randomUnavailableDaily,randomStateLost:messages.practice.randomStateLost,problemOf:messages.practice.problemOf },
}).replaceAll('<','\\u003c');
---
<div class="content-shell content-shell--problem">
  <div class="problem-context-nav">
    <a class="problem-back problem-back--archive" href={getRelativeLocaleUrl(locale,page.kind==='shortlist'?'shortlist':'problems')}><span aria-hidden="true">←</span>{page.kind==='shortlist'?messages.problem.backToShortlist:messages.problem.backToProblems}</a>
    <a class="problem-back problem-back--daily" data-daily-back href={getRelativeLocaleUrl(locale,'daily')}><span aria-hidden="true">←</span>{messages.problem.backToDaily}</a>
    <a class="problem-back problem-back--random" href={getRelativeLocaleUrl(locale,'random')}><span aria-hidden="true">←</span>{messages.problem.backToRandom}</a>
    <a class="problem-back problem-back--training" href={getRelativeLocaleUrl(locale,'training')}><span aria-hidden="true">←</span>{messages.problem.backToTraining}</a>
  </div>

  {import.meta.env.BW26_QA === '1' && <details class="qa-problem-tools">
    <summary>QA state</summary>
    <nav aria-label="QA problem experience state">
      <a href={`${routeWithLocale(page.route)}?qa=archive`}>Archive</a>
      <a href={`${routeWithLocale(page.route)}?qa=daily-current`}>Daily locked</a>
      <a href={`${routeWithLocale(page.route)}?qa=daily-past-solve`}>Past Daily solve</a>
      <a href={`${routeWithLocale(page.route)}?qa=daily-past-review`}>Past Daily review</a>
      <a href={`${routeWithLocale(page.route)}?qa=random-solve`}>Random solve</a>
      <a href={`${routeWithLocale(page.route)}?qa=random-review`}>Random review</a>
      <a href={`${routeWithLocale(page.route)}?qa=training-solve`}>Set solve</a>
      <a href={`${routeWithLocale(page.route)}?qa=training-review`}>Set review</a>
    </nav>
  </details>}

  <p class="problem-mode-context problem-mode-context--daily" aria-live="polite"><span class="kicker">{messages.problem.dailyContext}</span><span data-context-date-label></span></p>
  <p class="problem-mode-context problem-mode-context--random"><span class="kicker">{messages.problem.randomContext}</span></p>
  <p class="problem-mode-context problem-mode-context--training"><span class="kicker">{messages.problem.trainingContext}</span><span data-training-progress></span></p>

  <article class="problem-main">
    <header class="problem-heading">
      <h1 class="problem-title">{title}</h1>
      <p class="problem-domain"><span class="domain-mark" aria-hidden="true">{page.domain}</span><span class="problem-domain__separator" aria-hidden="true">·</span><span>{domainName}</span></p>
    </header>

    <section class="problem-prose problem-statement" lang="en" aria-label={messages.problem.statement} set:html={statement.html}></section>

    <section class="practice-actions practice-actions--random" aria-label={messages.problem.randomContext}>
      <div class="random-problem-actions"><button type="button" class="practice-primary" data-random-next>{messages.practice.anotherProblem}</button><a class="practice-text-link" href={getRelativeLocaleUrl(locale,'random')}>{messages.practice.changePool}</a></div>
    </section>
    <section class="practice-actions practice-actions--training" aria-label={messages.problem.trainingContext}>
      <nav class="training-step-actions" aria-label={messages.practice.practiceSet}>
        <span class="practice-step-slot practice-step-slot--previous"><a class="practice-step-link" data-training-prev hidden>{messages.practice.previousProblem}</a></span>
        <span class="practice-step-slot practice-step-slot--overview"><a class="practice-step-link practice-step-link--overview" data-training-overview-link href={getRelativeLocaleUrl(locale,'training')}>{messages.practice.setOverview}</a></span>
        <span class="practice-step-slot practice-step-slot--next"><a class="practice-step-link" data-training-next hidden>{messages.practice.nextProblem}</a></span>
      </nav>
      <button type="button" class="practice-secondary practice-end" data-training-end>{messages.practice.endPractice}</button>
    </section>
    <p class="practice-status" data-practice-status aria-live="polite"></p>

    <section class="review-gate" data-review-gate aria-labelledby="review-gate-title">
      <p id="review-gate-title">{messages.problem.reviewPrompt}</p>
      <button type="button" class="review-action" data-review-action>{messages.problem.reviewAction}</button>
    </section>
    <p class="review-locked-note" data-review-locked>{messages.problem.dailyLocked}</p>

    <section class="problem-review" data-review-context aria-labelledby="review-title">
      <h2 id="review-title" class="review-title">{messages.problem.review}</h2>

      {page.subtopics.length>0 && <section class="review-module" aria-labelledby="topics-title"><h3 id="topics-title">{messages.problem.topics}</h3><p class="review-topics">{page.subtopics.map(x=>subtopicLabel(x.id,x.label)).join(' · ')}</p></section>}

      <section class="review-module" aria-labelledby="solutions-title">
        <h3 id="solutions-title">{messages.problem.solutions}</h3>
        {renderedSolutions.length>0 ? <div class="solution-list">
          {renderedSolutions.map(solution=><details class="solution-disclosure"><summary>{solution.label}</summary><div class="problem-prose solution-body" lang="en" set:html={solution.rendered.html}></div></details>)}
        </div> : <p class="review-empty">{messages.problem.solutionUnavailable}</p>}
      </section>

      {page.results && <section class="review-module" aria-labelledby="contest-context-title">
        <h3 id="contest-context-title">{messages.problem.contestContext}</h3>
        <details class="context-disclosure results-disclosure">
          <summary>{messages.problem.resultsFrom} {page.results.year}</summary>
          <div class="results-body">
            <p class="results-team-count">{page.results.teamCount} {messages.problem.teams}</p>
            <dl class="results-metrics">
              <div><dt>{messages.problem.meanScore}</dt><dd>{numberFormat.format(page.results.meanScore)} / 5</dd></div>
              <div><dt>{messages.problem.scoresFourOrFive}</dt><dd>{page.results.scoreAtLeast4Count} / {page.results.teamCount}</dd></div>
              {page.results.estoniaScore!==null && <div><dt>{messages.problem.estonia}</dt><dd>{page.results.estoniaScore} / 5</dd></div>}
            </dl>
            <div class="score-distribution" aria-labelledby="score-distribution-title">
              <p id="score-distribution-title" class="results-subtitle">{messages.problem.scoreDistribution}</p>
              {page.results.distribution.map((count,score)=><div class="score-row"><span class="score-value">{score}</span><span class="score-track" aria-hidden="true"><span class="score-bar" style={`--score-width:${page.results!.teamCount?count/page.results!.teamCount*100:0}%`}></span></span><span class="score-count">{count}</span></div>)}
            </div>
            <details class="team-scores"><summary>{messages.problem.allTeamScores}</summary><div class="team-table-wrap"><table><thead><tr><th>{messages.problem.team}</th><th>{messages.problem.score}</th></tr></thead><tbody>{page.results.teams.map(team=><tr><td>{team.teamName}</td><td>{team.score} / 5</td></tr>)}</tbody></table></div></details>
          </div>
        </details>
      </section>}

      {(page.aopsUrl||page.officialResultsUrl) && <section class="review-module review-links" aria-labelledby="elsewhere-title"><h3 id="elsewhere-title">{messages.problem.elsewhere}</h3><ul>{page.aopsUrl&&<li><a href={page.aopsUrl}>{messages.problem.aopsYear} {page.year}<span aria-hidden="true"> ↗</span></a></li>}{page.officialResultsUrl&&<li><a href={page.officialResultsUrl}>{messages.problem.officialResults}<span aria-hidden="true"> ↗</span></a></li>}</ul></section>}
    </section>

    {page.kind==='final' && <nav class="problem-pager" aria-label={`${messages.problem.previous}/${messages.problem.next}`}>
      <div>{page.previous&&<a href={routeWithLocale(page.previous.route)}><span aria-hidden="true">←</span> {messages.archive.problem} {page.previous.number}</a>}</div>
      <div>{page.next&&<a href={routeWithLocale(page.next.route)}>{messages.archive.problem} {page.next.number} <span aria-hidden="true">→</span></a>}</div>
    </nav>}
  </article>
  <script id="bw26-problem-data" type="application/json" set:html={runtimeJson}></script>
</div>
<script>
  import { initProblemExperience } from '../../lib/client/problem-experience';
  const bootProblemExperience = () => initProblemExperience();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootProblemExperience, { once: true });
  } else {
    bootProblemExperience();
  }
</script>

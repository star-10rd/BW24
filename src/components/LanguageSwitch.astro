---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getMessages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const messages = getMessages(locale);
const targetLocale: Locale = locale === 'en' ? 'et' : 'en';
const href = `${getRelativeLocaleUrl(targetLocale, path)}${Astro.url.search}`;
const label = targetLocale === 'et' ? messages.common.useEstonian : messages.common.useEnglish;
---

<a class="language-switch" href={href} aria-label={label} title={label}>
  {targetLocale.toUpperCase()}
</a>

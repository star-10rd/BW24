---
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/600.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import type { PrimaryRoute } from '../config/site';
import { getMessages, type Locale } from '../i18n';
import { getPracticeCatalog } from '../lib/product/practice-catalog';
import MobileNav from '../components/MobileNav.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/shell.css';

interface Props {
  locale: Locale;
  current: PrimaryRoute | null;
  path: string;
  title: string;
  description?: string;
  experience?: { problemKey: string; dailyDates: string[] };
}

const { locale, current, path, title, description, experience } = Astro.props;
const messages = getMessages(locale);
const pageTitle = title === 'BW26' ? title : `${title} · BW26`;
const practice = experience ? await getPracticeCatalog() : null;
const experienceJson = JSON.stringify({
  locale,
  problemKey: experience?.problemKey ?? null,
  dailyDates: experience?.dailyDates ?? [],
  practiceCatalogFingerprint: practice?.fingerprint ?? null,
  publicSetFingerprint: practice?.publicSetFingerprint ?? null,
  randomStorageKey: 'bw26.practice.random.v2',
  trainingStorageKey: 'bw26.practice.training.v2',
  qaEnabled: import.meta.env.BW26_QA === '1',
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={locale} data-theme-pending data-experience="archive" data-review-state="available">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? messages.meta.description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{pageTitle}</title>
    <script id="bw26-experience-data" type="application/json" set:html={experienceJson}></script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored === 'light' || stored === 'dark'
            ? stored
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
        } catch {
          // CSS still honors the operating-system theme when storage is unavailable.
        }
        delete root.dataset.themePending;

        // Pre-paint is intentionally tiny: it only chooses a conservative visual
        // disclosure state. Full context/storage validation happens after the DOM
        // exists in problem-experience.ts. This script never reads or mutates body.
        const node = document.getElementById('bw26-experience-data');
        if (!node) return;
        let data;
        try { data = JSON.parse(node.textContent || '{}'); } catch { return; }
        if (!data.problemKey) return;
        const dates = Array.isArray(data.dailyDates)
          ? data.dailyDates.filter((value) => typeof value === 'string')
          : [];
        const tallinnDate = (now = new Date()) => {
          const parts = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'Europe/Tallinn', year: 'numeric', month: '2-digit', day: '2-digit',
          }).formatToParts(now);
          const map = Object.fromEntries(parts.map((part) => [part.type, part.value]));
          return `${map.year}-${map.month}-${map.day}`;
        };
        const params = new URLSearchParams(location.search);
        const today = tallinnDate();
        const qa = data.qaEnabled ? params.get('qa') : null;
        let experience = 'archive';
        let reviewState = 'available';
        let contextDate = null;
        let poolId = null;
        let sessionId = null;

        if (qa === 'daily-current') {
          experience = 'daily'; reviewState = 'locked'; contextDate = today;
        } else if (qa === 'daily-past-solve' || qa === 'daily-past-review') {
          experience = 'daily'; reviewState = qa === 'daily-past-review' ? 'review' : 'solve'; contextDate = dates[0] || today;
        } else if (qa === 'random-solve' || qa === 'random-review' || qa === 'random-current') {
          experience = 'random'; reviewState = qa === 'random-review' ? 'review' : 'solve'; poolId = 'qa';
        } else if (qa === 'training-solve' || qa === 'training-review' || qa === 'training-current') {
          experience = 'training'; reviewState = qa === 'training-review' ? 'review' : 'solve'; sessionId = 'qa';
        } else if (qa !== 'archive') {
          const requestedContext = params.get('context');
          if (requestedContext === 'daily') {
            const requested = params.get('date');
            if (requested && dates.includes(requested) && requested <= today) {
              experience = 'daily'; reviewState = 'solve'; contextDate = requested;
            }
          } else if (requestedContext === 'random') {
            experience = 'random'; reviewState = 'solve'; poolId = params.get('pool');
          } else if (requestedContext === 'training') {
            experience = 'training'; reviewState = 'solve'; sessionId = params.get('session');
          }
        }

        // A problem scheduled for today is locked regardless of how it was reached.
        if (dates.includes(today) || qa === 'random-current' || qa === 'training-current') reviewState = 'locked';

        root.dataset.experience = experience;
        root.dataset.reviewState = reviewState;
        if (contextDate) root.dataset.contextDate = contextDate; else delete root.dataset.contextDate;
        if (poolId) root.dataset.poolId = poolId; else delete root.dataset.poolId;
        if (sessionId) root.dataset.sessionId = sessionId; else delete root.dataset.sessionId;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{messages.common.skipToContent}</a>
    <SiteHeader locale={locale} current={current} path={path} />
    <main id="main-content" class="page-main">
      <slot />
    </main>
    <MobileNav locale={locale} current={current} />
  </body>
</html>

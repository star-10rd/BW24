---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getMessages, type Locale } from '../i18n';
import { getPracticeCatalog } from '../lib/product/practice-catalog';
import { getDailyDays } from '../lib/product/daily';
import '../styles/home.css';
import HomeEvents from '../components/HomeEvents.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = getMessages(locale);
const [practice, dailyDays] = await Promise.all([getPracticeCatalog(), getDailyDays()]);
const randomBase = getRelativeLocaleUrl(locale, 'random');
const trainingBase = getRelativeLocaleUrl(locale, 'training');
const practiceBase = getRelativeLocaleUrl(locale, 'practice');
const searchBase = getRelativeLocaleUrl(locale, 'search');
const problemsBase = getRelativeLocaleUrl(locale, 'problems');
const dailyBase = getRelativeLocaleUrl(locale, 'daily');
const materialsBase = getRelativeLocaleUrl(locale, 'materials');
const compactDays = dailyDays.map((day) => ({
  date: day.date,
  problems: Object.fromEntries(Object.entries(day.problems).map(([domain, problem]) => [domain, { id: problem.id, year: problem.year, number: problem.number }])),
}));
const dataJson = JSON.stringify({
  locale,
  catalogFingerprint: practice.fingerprint,
  publicSetFingerprint: practice.publicSetFingerprint,
  publicIds: practice.exercises.map((exercise) => exercise.id),
  dailyDays: compactDays,
  labels: {
    recent: messages.practice.recent,
    random: messages.practice.randomSource,
    training: messages.practice.practiceSet,
    continueTraining: messages.practice.continuePractice,
    problemOf: messages.practice.problemOf,
    shortlistProblem: messages.problem.shortlistProblem,
    problem: messages.archive.problem,
    outsideCoverage: messages.daily.outsideCoverage,
    domains: messages.problem.domains,
  },
}).replaceAll('<', '\\u003c');
---

<div class="content-shell home-shell">
  <header class="page-heading page-heading--home">
    <p class="kicker">{messages.home.kicker}</p>
    <h1>{messages.home.title}</h1>
    <p class="lede">{messages.home.intro}</p>
  </header>

  <section class="home-today" aria-labelledby="home-today-title">
    <div class="home-section-heading">
      <div>
        <p class="kicker">{messages.home.todayLabel}</p>
        <h2 id="home-today-title" data-home-today-date>{messages.home.dailyAction}</h2>
      </div>
      <a href={dailyBase}>{messages.home.openToday}</a>
    </div>
    <div class="home-today-set" data-home-today-set></div>
    <p class="home-today-fallback" data-home-today-fallback hidden>{messages.daily.outsideCoverage}</p>
  </section>

  <HomeEvents locale={locale} />

  <section class="home-practice" aria-labelledby="home-practice-title">
    <div class="home-section-heading">
      <div><p class="kicker">{messages.home.practiceLabel}</p><h2 id="home-practice-title">{messages.sections.practice.title}</h2></div>
      <a href={practiceBase}>{messages.sections.practice.title}</a>
    </div>
    <div class="home-practice-list">
      <div class="home-practice-item">
        <div><h3>{messages.home.randomLabel}</h3><p>{messages.home.randomText}</p></div>
        <a class="home-primary-action" href={`${randomBase}?start=1`}>{messages.practice.giveProblem}</a>
      </div>
      <div class="home-practice-item">
        <div><h3>{messages.practice.practiceSet}</h3><p>{messages.home.trainingText}</p></div>
        <div class="home-practice-actions"><a class="home-secondary-button" href={`${trainingBase}?start=1&size=5`}>{messages.practice.fiveProblems}</a><a class="home-secondary-button" href={`${trainingBase}?start=1&size=10`}>{messages.practice.tenProblems}</a></div>
      </div>
      <div class="home-practice-item home-practice-item--find">
        <div><h3>{messages.practice.findProblem}</h3><p>{messages.sections.search.description}</p></div>
        <div class="home-inline-links"><a href={searchBase}>{messages.practice.searchProblems}</a><a href={problemsBase}>{messages.practice.browseProblems}</a></div>
      </div>
    </div>
  </section>

  <section class="home-continue" data-home-training-continue hidden>
    <div><p class="kicker">{messages.practice.continuePractice}</p><h2>{messages.practice.practiceSet}</h2><p data-home-training-meta></p></div>
    <a class="home-secondary-button" data-home-training-link href={trainingBase}>{messages.practice.continuePractice}</a>
  </section>

  <section class="home-recent" data-home-recent hidden aria-labelledby="home-recent-title">
    <div class="home-section-heading"><h2 id="home-recent-title">{messages.home.recentLabel}</h2><a href={practiceBase}>{messages.sections.practice.title}</a></div>
    <ul data-home-recent-list></ul>
  </section>

  <p class="home-materials-link"><a href={materialsBase}>{messages.practice.materials}</a></p>
  <script id="bw26-home-practice-data" type="application/json" set:html={dataJson}></script>
</div>

<script>
  import { initHomePractice } from '../lib/client/home-practice';
  initHomePractice();
</script>

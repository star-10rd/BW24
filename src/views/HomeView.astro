---
import {getRelativeLocaleUrl} from 'astro:i18n';import {getMessages,type Locale} from '../i18n'; interface Props{locale:Locale} const{locale}=Astro.props;const m=getMessages(locale);
---
<div class="content-shell content-shell--reading"><header class="page-heading page-heading--home"><p class="kicker">{m.home.kicker}</p><h1>{m.home.title}</h1><p class="lede">{m.home.intro}</p></header><div class="home-actions"><a class="home-primary-action" href={getRelativeLocaleUrl(locale,'daily')}>{m.home.dailyAction}<span aria-hidden="true">→</span></a><a class="text-action" href={getRelativeLocaleUrl(locale,'problems')}>{m.home.problemsAction}<span aria-hidden="true">→</span></a></div><section class="foundation-list"><div class="foundation-row"><h2>{m.home.problemsLabel}</h2><p>{m.home.problemsText}</p></div><div class="foundation-row"><h2>{m.home.trainingLabel}</h2><p>{m.home.trainingText}</p></div><div class="foundation-row"><h2>{m.home.materialsLabel}</h2><p>{m.home.materialsText}</p></div></section></div>

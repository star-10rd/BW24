---
import { getMessages, type Locale } from '../i18n';
import { getPracticeCatalog } from '../lib/product/practice-catalog';
import '../styles/practice.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = getMessages(locale);
const practice = await getPracticeCatalog();
const years = [...new Set(practice.exercises.map((exercise) => exercise.year))].sort((a,b)=>b-a);
const domainOrder = ['A','C','G','N'] as const;
const dataJson = JSON.stringify({
  locale,
  catalogFingerprint: practice.fingerprint,
  publicSetFingerprint: practice.publicSetFingerprint,
  catalog: practice.exercises,
  labels: {
    eligible: messages.practice.eligible,
    unavailableDaily: messages.practice.randomUnavailableDaily,
    storageFallback: messages.practice.storageFallback,
    selectionFailed: messages.practice.selectionFailed,
  },
}).replaceAll('<','\\u003c');
---
<div class="content-shell practice-shell practice-shell--simple">
  <header class="page-heading"><h1>{messages.sections.random.title}</h1><p class="lede">{messages.sections.random.description}</p></header>
  <form class="practice-form practice-form--simple" data-random-form>
    <fieldset class="quick-scope" data-random-simple-domain>
      <legend>{messages.practice.focus}</legend>
      <label><input type="radio" name="simple-domain" value="all" checked/><span>{messages.practice.allDomains}</span></label>
      {domainOrder.map((domain)=><label><input type="radio" name="simple-domain" value={domain}/><span><strong>{domain}</strong><span class="quick-scope__name">{messages.problem.domains[domain]}</span></span></label>)}
    </fieldset>

    <label class="practice-toggle"><input type="checkbox" name="shortlist"/><span>{messages.practice.includeShortlistShort}</span></label>

    <div class="practice-primary-block">
      <p class="practice-count" data-random-count aria-live="polite"></p>
      <button type="submit" class="practice-submit practice-submit--large">{messages.practice.giveProblem}</button>
      <p class="practice-form-status" data-random-status aria-live="polite"></p>
    </div>

    <details class="practice-details practice-details--customize" data-random-customize>
      <summary>{messages.practice.customize}</summary>
      <div class="practice-details__body">
        <fieldset class="practice-fieldset practice-fieldset--inline practice-advanced-domains">
          <legend>{messages.practice.domainsAdvanced}</legend>
          {domainOrder.map((domain)=><label class="choice-pill"><input type="checkbox" name="domain" value={domain} checked/><span><strong>{domain}</strong> · {messages.problem.domains[domain]}</span></label>)}
        </fieldset>

        <fieldset class="practice-fieldset practice-grid practice-years"><legend>{messages.practice.years}</legend>
          {years.map((year)=><label class="choice-check"><input type="checkbox" name="year" value={String(year)} checked/><span>{year}</span></label>)}
        </fieldset>

        <label class="choice-check choice-check--standalone"><input type="checkbox" name="verified"/><span>{messages.practice.verifiedSolutionOnly}</span></label>
        <div class="topic-groups">
          {domainOrder.map((domain)=><fieldset class="practice-fieldset topic-group"><legend>{messages.problem.domains[domain]}</legend>{practice.topics.filter((topic)=>topic.domain===domain).map((topic)=><label class="choice-check"><input type="checkbox" name="topic" value={topic.id}/><span>{messages.taxonomy.subtopics[topic.id]??topic.label}</span></label>)}</fieldset>)}
        </div>
      </div>
    </details>
  </form>
  <script id="bw26-random-data" type="application/json" set:html={dataJson}></script>
</div>
<script>
  import { initRandomPage } from '../lib/client/random-page';
  initRandomPage();
</script>

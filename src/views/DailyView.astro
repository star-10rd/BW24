---
import { getMessages,type Locale } from '../i18n';
import { getDailyDays } from '../lib/product/daily';
import '../styles/daily.css';
interface Props{locale:Locale}
const {locale}=Astro.props;
const messages=getMessages(locale);
const days=await getDailyDays();
const compact=days.map(day=>({date:day.date,problems:Object.fromEntries(Object.entries(day.problems).map(([domain,p])=>[domain,{year:p.year,number:p.number}]))}));
const dataJson=JSON.stringify({locale,days:compact,labels:{...messages.daily,domains:messages.daily.domains,problem:messages.archive.problem}}).replaceAll('<','\\u003c');
---
<div class="content-shell daily-shell">
  <header class="page-heading"><h1>{messages.sections.daily.title}</h1><p class="lede">{messages.sections.daily.description}</p></header>
  <section class="daily-day" aria-labelledby="daily-date-heading">
    <div class="daily-date-line"><p class="kicker" data-daily-today-marker hidden>{messages.daily.today}</p><h2 id="daily-date-heading" class="daily-date" data-daily-status aria-live="polite"></h2></div>
    <div class="daily-set" data-daily-set></div>
    <p class="daily-countdown" data-daily-countdown></p>
    <nav class="daily-nav" aria-label={messages.daily.date}>
      <button type="button" data-daily-prev>{messages.daily.previousDay}</button>
      <button type="button" data-daily-today hidden>{messages.daily.todayAction}</button>
      <button type="button" data-daily-next>{messages.daily.nextDay}</button>
    </nav>
    <details class="daily-history" data-daily-history>
      <summary>{messages.daily.previousDays}</summary>
      <div class="daily-history-list" data-daily-history-list></div>
    </details>
  </section>
  <script id="bw26-daily-data" type="application/json" set:html={dataJson}></script>
</div>
<script is:inline>
(()=>{
  const node=document.getElementById('bw26-daily-data'); if(!node)return;
  let data; try{data=JSON.parse(node.textContent||'{}')}catch{return}
  const root=document.querySelector('[data-daily-set]');
  const prev=document.querySelector('[data-daily-prev]');
  const next=document.querySelector('[data-daily-next]');
  const todayButton=document.querySelector('[data-daily-today]');
  const todayMarker=document.querySelector('[data-daily-today-marker]');
  const status=document.querySelector('[data-daily-status]');
  const countdown=document.querySelector('[data-daily-countdown]');
  const historyList=document.querySelector('[data-daily-history-list]');
  if(!root||!prev||!next||!todayButton||!todayMarker||!status||!countdown||!historyList)return;

  const tallinnDate=(now=new Date())=>{const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Tallinn',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(now);const map=Object.fromEntries(parts.map(p=>[p.type,p.value]));return `${map.year}-${map.month}-${map.day}`;};
  const pretty=(value)=>{const[y,m,d]=value.split('-').map(Number);return new Intl.DateTimeFormat(data.locale==='et'?'et-EE':'en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Tallinn'}).format(new Date(Date.UTC(y,m-1,d,12)))};
  const byDate=new Map(data.days.map(x=>[x.date,x]));
  let today=tallinnDate();
  let allowed=data.days.filter(x=>x.date<=today);
  const requested=new URLSearchParams(location.search).get('date');
  let current=(requested&&byDate.has(requested)&&requested<=today)?requested:(byDate.has(today)?today:(allowed.at(-1)?.date??null));

  function countdownText(){const start=Date.now(),todayKey=tallinnDate(new Date(start));let lo=start,hi=start+30*60*60*1000;while(hi-lo>60000){const mid=Math.floor((lo+hi)/2);if(tallinnDate(new Date(mid))===todayKey)lo=mid;else hi=mid;}const mins=Math.max(0,Math.ceil((hi-start)/60000));return `${Math.floor(mins/60)}h ${mins%60}m`;}
  function writeUrl(){if(!current)return;const target=current===today?location.pathname:`${location.pathname}?date=${current}`;history.replaceState(history.state,'',target);}
  function makeProblemLink(domain,p){const prefix=data.locale==='et'?'/et':'';const a=document.createElement('a');a.className='daily-problem';a.href=`${prefix}/problems/${p.year}/${p.number}/?context=daily&date=${current}`;a.dataset.dailyProblemLink='';const mark=document.createElement('span');mark.className='daily-domain-mark';mark.textContent=domain;const name=document.createElement('span');name.className='daily-domain-name';name.textContent=data.labels.domains[domain];const source=document.createElement('span');source.className='daily-source';source.textContent=`Baltic Way ${p.year} · ${data.labels.problem} ${p.number}`;a.append(mark,name,source);return a;}
  function renderHistory(){historyList.replaceChildren();const recent=allowed.slice(-14).reverse();for(const day of recent){const button=document.createElement('button');button.type='button';button.className='daily-history-date';button.textContent=pretty(day.date);if(day.date===current)button.setAttribute('aria-current','date');button.addEventListener('click',()=>{current=day.date;render();document.querySelector('[data-daily-history]')?.removeAttribute('open');});historyList.append(button);}}
  function render(){
    if(!current){prev.hidden=true;next.hidden=true;todayButton.hidden=true;todayMarker.hidden=true;root.replaceChildren();countdown.textContent='';status.textContent=data.labels.outsideCoverage;renderHistory();return;}
    const day=byDate.get(current);if(!day){current=null;render();return;}
    const isToday=current===today;todayMarker.hidden=!isToday;todayButton.hidden=isToday||!byDate.has(today);status.textContent=pretty(current);
    root.replaceChildren(...['A','C','G','N'].map(domain=>makeProblemLink(domain,day.problems[domain])));
    const index=allowed.findIndex(x=>x.date===current);prev.hidden=index<=0;next.hidden=index<0||index>=allowed.length-1;
    countdown.textContent=isToday?`${data.labels.nextDaily}: ${countdownText()}`:'';writeUrl();renderHistory();
  }
  prev.addEventListener('click',()=>{const i=allowed.findIndex(x=>x.date===current);if(i>0){current=allowed[i-1].date;render();}});
  next.addEventListener('click',()=>{const i=allowed.findIndex(x=>x.date===current);if(i>=0&&i<allowed.length-1){current=allowed[i+1].date;render();}});
  todayButton.addEventListener('click',()=>{if(byDate.has(today)){current=today;render();}});
  window.addEventListener('popstate',()=>{const q=new URLSearchParams(location.search).get('date');current=(q&&byDate.has(q)&&q<=today)?q:(byDate.has(today)?today:(allowed.at(-1)?.date??null));render();});
  render();
  window.setInterval(()=>{const nextToday=tallinnDate();if(nextToday!==today){const oldToday=today;today=nextToday;allowed=data.days.filter(x=>x.date<=today);if(current===oldToday&&byDate.has(today))current=today;render();return;}if(current===today)countdown.textContent=`${data.labels.nextDaily}: ${countdownText()}`;},60000);
})();
</script>

---
import { getRelativeLocaleUrl } from 'astro:i18n'; import { getMessages,type Locale } from '../i18n'; import { getProductCatalog } from '../lib/product/catalog'; import '../styles/archive.css';
interface Props{locale:Locale;year:number} const {locale,year}=Astro.props; const messages=getMessages(locale); const catalog=await getProductCatalog(); const problems=catalog.finals.filter(x=>x.year===year).sort((a,b)=>Number(a.number)-Number(b.number)); if(!problems.length)throw new Error(`No public problems for ${year}`);
---
<div class="content-shell archive-shell"><a class="archive-back" href={getRelativeLocaleUrl(locale,'problems')}><span aria-hidden="true">←</span>{messages.problem.backToProblems}</a><header class="page-heading"><h1>{locale === 'et' ? 'Balti Tee' : 'Baltic Way'} {year}</h1><p class="lede">{problems.length} {messages.archive.problems}</p></header><ol class="contest-problem-list">{problems.map(problem=><li><a href={getRelativeLocaleUrl(locale,`problems/${problem.year}/${Number(problem.number)}`)}><span class="contest-number">{messages.archive.problem} {Number(problem.number)}</span><span class="contest-domain"><strong aria-hidden="true">{problem.domain}</strong> · {messages.problem.domains[problem.domain]}</span><span aria-hidden="true">→</span></a></li>)}</ol></div>

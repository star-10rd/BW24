{
  "schema": "bw26-balticway-results-registry",
  "version": 2,
  "competition": "Baltic Way",
  "coverage": {
    "firstYear": 1992,
    "lastYear": 2025,
    "years": 34,
    "teamParticipations": 362,
    "note": "Results begin in 1992 in the official Baltic Way archive; 1990-1991 intentionally have no local results file."
  },
  "source": {
    "authoritativeProvider": "Baltic Way official archive (University of Tartu / host-year official result pages)",
    "authoritativeIndexUrl": "https://www.math.olympiaadid.ut.ee/eng/html/?id=bw",
    "mirrorProvider": "MOResults",
    "mirrorDataPageUrl": "https://moresults.org/data",
    "mirrorRepositoryUrl": "https://github.com/matholympiadresults/moresults-data",
    "mirrorParsedPathTemplate": "data/balticway/parsed/{year}/scoreboard.json",
    "mirrorRepositoryRef": null,
    "mirrorSnapshotSha256": null,
    "numericImportState": "complete",
    "gitPinState": "pending-byte-level-cross-check",
    "note": "The 34 local matrices were normalized from the official result tables and validate to 362 team participations, matching MOResults coverage. A future pinned clone of moresults-data can fill repositoryRef/snapshotSha256 without changing the BW26 matrix schema."
  },
  "displayPolicy": {
    "interpretation": "historical contest performance only; never label or infer intrinsic problem difficulty",
    "selectionSignal": false,
    "deriveAtRuntime": [
      "teamCount",
      "meanScore",
      "scoreDistribution0To5",
      "fullScoreCount",
      "scoreAtLeast4Count",
      "estoniaScore",
      "allTeamScores"
    ],
    "doNotPersist": [
      "meanScore",
      "scoreDistribution0To5",
      "fullScoreCount",
      "scoreAtLeast4Count",
      "estoniaScore"
    ],
    "deferMetrics": [
      "correlations",
      "standardDeviation",
      "difficultyLabels",
      "historicalCountryAnalytics"
    ],
    "note": "Visibility/spoiler behavior should be enforced centrally by the P3E review-context layer together with solutions and AoPS, not independently by this registry."
  },
  "normalization": {
    "dashScores": "Historical official tables sometimes use “-”. BW26 normalizes this to numeric 0 points only; it does not infer whether a team attempted the problem.",
    "teamNames": "Obvious presentation/translation variants are normalized (for example Saint Petersburg -> St. Petersburg, Holland -> Netherlands, Denamrk -> Denmark, Valgevene -> Belarus).",
    "ties": "rank is the first ordinal position of a tied group (competition ranking); duplicate ranks are valid.",
    "countryCodes": "ISO-like two-letter codes where unambiguous; null for non-country historical teams such as St. Petersburg."
  },
